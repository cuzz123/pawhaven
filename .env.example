# PawHaven Environment Variables

# App
NEXT_PUBLIC_APP_URL=https://pawhaven.vercel.app

# Auth (Next-Auth v5)
AUTH_SECRET=  # Generate: openssl rand -base64 32
GOOGLE_CLIENT_ID=  # From https://console.cloud.google.com
GOOGLE_CLIENT_SECRET=  # From https://console.cloud.google.com

# Database (Prisma + Neon)
DATABASE_URL=  # postgresql://user:pass@host/db?sslmode=require

# Email (Resend)
RESEND_API_KEY=re_xxx  # From https://resend.com/api-keys
RESEND_AUDIENCE_ID=xxx  # For newsletter

# Upstash Redis (rate limiting)
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
